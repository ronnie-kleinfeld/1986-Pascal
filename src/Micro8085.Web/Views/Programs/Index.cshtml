@using Micro8085.Core.Assembly
@model IReadOnlyList<Micro8085.Core.Storage.CatalogEntry>
@{
    ViewData["Title"] = "Directory";
}

<section class="window">
    <h1>INPUT OUTPUT - DIRECTORY</h1>

    @if (TempData["Message"] is string flash)
    {
        <p class="flash" role="status">@flash</p>
    }

    @if (Model.Count == 0)
    {
        <p class="hint">No file</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th scope="col">NAME</th><th scope="col">START</th><th scope="col">RANGE</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td>@entry.Name</td>
                        <td>@Hex.Word(entry.StartAddress)</td>
                        <td>@Hex.Word(entry.Length)</td>
                        <td class="actions">
                            <a asp-action="Load" asp-route-id="@entry.Name">Load</a>
                            <a asp-action="Save" asp-route-id="@entry.Name">Save</a>
                            <a asp-action="Erase" asp-route-id="@entry.Name">Erase</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="form-actions">
        <a class="button" asp-action="Load">1. Load</a>
        <a class="button" asp-action="Save">2. Save</a>
    </div>
    <p class="hint">Esc / F7 Exit</p>
</section>
