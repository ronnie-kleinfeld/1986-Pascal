@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="window">
    <h1>ERROR</h1>
    <p>An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }
    <p class="hint">Esc / F7 Exit</p>
</section>
