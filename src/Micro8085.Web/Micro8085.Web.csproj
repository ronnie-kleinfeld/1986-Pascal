<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Micro8085.Core\Micro8085.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 1986 sample programs and their catalog, copied into the program directory on first run. -->
    <None Include="..\..\MICRO\*.DAT" Exclude="..\..\MICRO\EXT-KEY.DAT" LinkBase="SeedPrograms" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Content\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

</Project>
